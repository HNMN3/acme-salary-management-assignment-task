# Copy to .env to override the defaults. Compose reads it automatically.

# Backend: SQLAlchemy URL. The production container keeps its database on the /data volume.
DATABASE_URL=sqlite:////data/salary.db

# Backend: comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Backend: create tables and seed 10,000 employees on startup when the database is empty.
SEED_ON_STARTUP=true

# Frontend: API base URL, read by the browser. Baked in at build time for the production image.
VITE_API_URL=http://localhost:8000/api/v1
